{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "let-reviewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "let-reviewer-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "0.0.0.0",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "let-reviewer-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "let-reviewer-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175"
      ],
      "port": 5175,
      "env": {
        "VITE_SUPABASE_URL": "",
        "VITE_SUPABASE_PUBLISHABLE_KEY": ""
      }
    }
  ]
}